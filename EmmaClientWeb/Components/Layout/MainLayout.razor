@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject NavigationManager Nav

@* ------------------------------------------------------------------
   Shell applicativa: barra di navigazione laterale + topbar.
   La pagina di login usa la stessa MainLayout ma senza shell.
   ------------------------------------------------------------------ *@

@if (IsLoginPage)
{
    <div class="emma-plain">
        @Body
    </div>
}
else
{
    <div class="emma-app @(_navCollapsed ? "nav-collapsed" : "") @(_navMobileOpen ? "nav-mobile-open" : "")">

        <aside class="emma-sidebar">
            <a class="emma-brand" href="/dashboard" @onclick="ChiudiNavMobile">
                <EmmaLogo Class="emma-logo" />
                <span class="emma-brand-text">
                    <b>EMMA</b>
                    <span>Doc Platform</span>
                </span>
            </a>

            <nav class="emma-nav">
                <a class="emma-nav-link @(IsActive("/dashboard") ? "active" : "")" href="/dashboard" @onclick="ChiudiNavMobile">
                    <EmmaIcon Name="home" />
                    <span class="emma-nav-label">Dashboard</span>
                </a>

                @foreach (var gruppo in Menu)
                {
                    <div class="emma-nav-group">@gruppo.Titolo</div>

                    @foreach (var voce in gruppo.Voci)
                    {
                        <a class="emma-nav-link @(IsActive(voce.Href) ? "active" : "")" href="@voce.Href"
                           title="@voce.Label" @onclick="ChiudiNavMobile">
                            <EmmaIcon Name="@voce.Icona" />
                            <span class="emma-nav-label">@voce.Label</span>
                        </a>
                    }
                }
            </nav>

            @if (Session.IsAuthenticated)
            {
                <div class="emma-sidebar-footer">
                    <span class="emma-avatar" title="@Session.User">@Iniziale</span>
                    <span class="emma-user-meta">
                        <b>@Session.User</b>
                        <span>Utente connesso</span>
                    </span>
                    <button class="emma-ghostbtn" type="button" title="Esci" aria-label="Esci" @onclick="Esci">
                        <EmmaIcon Name="logout" />
                    </button>
                </div>
            }
        </aside>

        <div class="emma-scrim" @onclick="ChiudiNavMobile"></div>

        <div class="emma-main">
            <header class="emma-topbar">
                <button class="emma-ghostbtn" type="button" title="Mostra/nascondi menu"
                        aria-label="Mostra o nascondi il menu" @onclick="ToggleNav">
                    <EmmaIcon Name="menu" />
                </button>

                @if (!IsDashboard)
                {
                    <button class="emma-ghostbtn" type="button" @onclick="@(() => Nav.NavigateTo("/dashboard"))">
                        <EmmaIcon Name="back" />
                        <span class="hide-sm">Indietro</span>
                    </button>
                }

                <span class="emma-page-title">@Title</span>
                <span class="emma-spacer"></span>

                <button class="emma-ghostbtn" type="button" title="Manuale utente"
                        aria-label="Apri il manuale utente" @onclick="ApriManuale">
                    <EmmaIcon Name="book" />
                    <span class="hide-sm">Manuale</span>
                </button>
            </header>

            <div class="emma-view">
                @Body
            </div>
        </div>
    </div>
}

@* Manuale utente: stessa finestra modale usata per gli allegati PDF, ma il file
   è statico e servito da wwwroot, quindi non passa dalla PdfCache. *@
@if (_manualeAperto)
{
    <div class="pdf-overlay" @onclick="ChiudiManuale">
        <div class="pdf-window" @onclick:stopPropagation="true">
            <div class="pdf-header">
                <span class="title">Manuale Utente – EMMA Client Web</span>
                <a class="btn btn-blue btn-sm" href="@ManualeUrl" download>💾 Scarica</a>
                <a class="btn btn-blue btn-sm" href="@ManualeUrl" target="_blank">↗ Nuova scheda</a>
                <button class="btn btn-grey btn-sm" @onclick="ChiudiManuale">❌ Chiudi</button>
            </div>
            <iframe src="@($"{ManualeUrl}#toolbar=1")" title="Manuale Utente – EMMA Client Web"></iframe>
        </div>
    </div>
}

@code {

    // ---- Navigazione laterale -------------------------------------------

    private sealed record VoceMenu(string Href, string Icona, string Label);
    private sealed record GruppoMenu(string Titolo, VoceMenu[] Voci);

    private static readonly GruppoMenu[] Menu =
    [
        new GruppoMenu("Documenti",
        [
            new VoceMenu("/documenti/carica-documento", "doc-upload", "Carica Documento"),
            new VoceMenu("/documenti/ricerca", "search", "Ricerca")
        ]),
        new GruppoMenu("Ordini Bolle Fatture",
        [
            new VoceMenu("/documenti/carica", "upload", "Carica Ordini Bolle Fatture"),
            new VoceMenu("/documenti", "files", "Visualizza Ordini Bolle Fatture")
        ]),
        new GruppoMenu("Anagrafiche Fornitori",
        [
            new VoceMenu("/fornitori", "truck", "Fornitori"),
            new VoceMenu("/articoli", "box", "Articoli Fornitore")
        ]),
        new GruppoMenu("Conciliazione",
        [
            new VoceMenu("/conciliazione-ordini", "compare", "Ordini → Bolle"),
            new VoceMenu("/conciliazione", "check-doc", "Bolle → Fatture")
        ]),
        new GruppoMenu("Sistema",
        [
            new VoceMenu("/log", "log", "Log"),
            new VoceMenu("/password", "key", "Cambio Password")
        ])
    ];

    // Su desktop il pulsante comprime la sidebar a icone, su mobile apre/chiude
    // il drawer: le due classi sono gestite da media query diverse.
    private bool _navCollapsed;
    private bool _navMobileOpen;

    private void ToggleNav()
    {
        _navCollapsed = !_navCollapsed;
        _navMobileOpen = !_navMobileOpen;
    }

    private void ChiudiNavMobile() => _navMobileOpen = false;

    private bool IsActive(string href) => Path == href.Trim('/').ToLowerInvariant();

    private string Iniziale => string.IsNullOrWhiteSpace(Session.User)
        ? "?"
        : Session.User.Trim()[..1].ToUpperInvariant();

    // File statico sotto wwwroot: rigenerandolo da Manuale/*.md va sovrascritto qui.
    private const string ManualeUrl = "manuale/Manuale_Utente_EMMA.pdf";

    private bool _manualeAperto;

    private string Path => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/').ToLowerInvariant();

    // Titolo della "Window" corrente, come i Title delle Window Avalonia
    private string Title => Path switch
    {
        "dashboard" => "Dashboard",
        "documenti/carica-documento" => "Carica Documento",
        "documenti/ricerca" => "Ricerca",
        "documenti/carica" => "Carica Ordini Bolle Fatture",
        "documenti" => "Visualizza Ordini Bolle Fatture",
        "fornitori" => "Fornitori",
        "articoli" => "Articoli Fornitore",
        "conciliazione" => "Conciliazione Bolle / Fatture",
        "conciliazione-ordini" => "Conciliazione Ordini / Bolle",
        "log" => "Log",
        "password" => "Cambio Password",
        _ => "Emma Client"
    };

    private bool IsLoginPage => Path.Length == 0 || Path == "login";
    private bool IsDashboard => Path == "dashboard";

    protected override void OnInitialized()
    {
        Session.Changed += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void ApriManuale() => _manualeAperto = true;

    private void ChiudiManuale() => _manualeAperto = false;

    private void Esci()
    {
        _manualeAperto = false;
        Session.SignOut();
        Nav.NavigateTo("/login");
    }
}
