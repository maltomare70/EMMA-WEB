@page "/conciliazione-ordini"
@layout MainLayout

@* Conciliazione Ordini -> Bolle / DDT.
   Tutta la GUI e la logica stanno in Components/Shared/ConciliazioneView.razor:
   qui si dichiarano solo i parametri di questa variante. *@

<ConciliazioneView Chiave="ORDINI-BOLLE"
                   TitoloSinistra="Ordini"
                   TipiDocSinistra="@TipiSinistra"
                   FiltraDateSinistra="false"
                   NomeRigheSinistra="ordine"
                   TestoVuotoSinistra="@VuotoSinistra"
                   TitoloDestra="Bolle / DDT"
                   TipiDocDestra="@TipiDestra"
                   FiltraDateDestra="true"
                   NomeRigheDestra="bolla"
                   TestoVuotoDestra="@VuotoDestra" />

@code {
    // Griglia di sinistra: ordini (senza filtro date, come da comportamento attuale)
    private static readonly int[] TipiSinistra =
    {
        ConciliazioneView.TipiDoc.Ordine
    };

    // Griglia di destra: DDT / bolle
    private static readonly int[] TipiDestra =
    {
        ConciliazioneView.TipiDoc.Ddt
    };

    private const string VuotoSinistra = "Imposta i filtri e premi \"Carica Dati\" per caricare gli ordini.";
    private const string VuotoDestra = "Imposta i filtri e premi \"Carica Dati\" per caricare le bolle.";
}
