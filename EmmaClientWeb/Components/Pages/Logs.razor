@page "/log"
@layout MainLayout
@inject UserSession Session
@inject EmmaServiceFactory Factory
@inject NavigationManager Nav

@* Replica di Forms/Logs/LogForms.axaml *@

<div class="emma-page @(_busy ? "busy" : "")">

    <div class="emma-toolbar">
        <div class="emma-toolbar-left">
            <button class="btn btn-default" @onclick="CaricaDati" disabled="@_busy">🔄 Ricarica</button>

            <div class="emma-separator"></div>

            @* Filtri applicati lato client sulle righe già caricate: non richiedono una nuova chiamata *@
            <div class="emma-field">
                <label for="dtDa">Da:</label>
                <input id="dtDa" class="emma-input" type="date" style="width:150px"
                       @bind="_da" @bind:format="yyyy-MM-dd" @bind:after="AggiornaFiltro"
                       disabled="@_busy" />
            </div>

            <div class="emma-field">
                <label for="dtA">A:</label>
                <input id="dtA" class="emma-input" type="date" style="width:150px"
                       @bind="_a" @bind:format="yyyy-MM-dd" @bind:after="AggiornaFiltro"
                       disabled="@_busy" />
            </div>

            <div class="emma-field">
                <label for="cboStato">Stato:</label>
                <select id="cboStato" class="emma-select" style="width:190px"
                        value="@_stato" @onchange="OnStatoChanged" disabled="@_busy">
                    <option value="">Tutti</option>
                    @foreach (var s in StatiDisponibili)
                    {
                        <option value="@s">@DescrizioneStato(s)</option>
                    }
                </select>
            </div>

            <button class="btn btn-default btn-sm" @onclick="() => ImpostaMese(0)"
                    disabled="@_busy">Mese corrente</button>
            <button class="btn btn-default btn-sm" @onclick="() => ImpostaMese(-1)"
                    disabled="@_busy">Mese precedente</button>
            <button class="btn btn-grey btn-sm" @onclick="PulisciFiltro"
                    disabled="@_busy">Reimposta filtri</button>

            <div class="emma-separator"></div>

            @if (FiltroAttivo)
            {
                <span class="file-label done">@LogFiltrati.Count righe su @ListaLog.Count</span>
            }
            else
            {
                <span class="file-label done">@ListaLog.Count righe di log</span>
            }
        </div>
    </div>

    <div class="emma-grid-wrapper">
        <table class="emma-grid">
            <thead>
                <tr>
                    <th style="width:180px">Data Creazione</th>
                    <th style="width:100px">Stato</th>
                    <th>Note</th>
                    <th style="width:100px">Durata (sec.)</th>
                </tr>
            </thead>
            <tbody>
                @if (!ListaLog.Any())
                {
                    <tr><td colspan="4" class="empty-state">Nessun log disponibile.</td></tr>
                }
                else if (!LogFiltrati.Any())
                {
                    <tr><td colspan="4" class="empty-state">Nessun log nel periodo selezionato.</td></tr>
                }
                else
                {
                    @foreach (var l in LogFiltrati)
                    {
                        <tr>

                            <td>@l.data_creazione.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="cell-center">@l.stato</td>
                            <td>@l.message</td>
                            <td class="cell-right">@l.duration</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<EmmaDialogs @ref="_dialogs" />

@code {
    private List<EmmaLog> ListaLog { get; set; } = new();
    private bool _busy;
    private EmmaDialogs _dialogs = default!;
    private Emma.Services.Services.LogServiceClient _logService = default!;

    // Filtri applicati lato client sulle righe già caricate
    private DateTime? _da;
    private DateTime? _a;

    /// <summary>Stato selezionato; null significa "Tutti". Default: 1 (elaborazioni riuscite).</summary>
    private int? _stato = 1;

    /// <summary>Valori scritti dal server in EmmaLog.stato.</summary>
    private static readonly int[] StatiDisponibili = { -2, -1, 0, 1 };

    private static string DescrizioneStato(int stato) => stato switch
    {
        1 => "1 – OK",
        0 => "0 – Non definito",
        -1 => "-1 – Errore AI",
        -2 => "-2 – Errore server",
        _ => stato.ToString()
    };

    private bool FiltroAttivo => _da.HasValue || _a.HasValue || _stato.HasValue;

    /// <summary>
    /// Righe nel periodo selezionato. Calcolato una volta per cambio di filtro o di dati,
    /// non a ogni accesso: in una singola render viene letto più volte.
    /// </summary>
    private List<EmmaLog> LogFiltrati { get; set; } = new();

    /// <summary>
    /// Riapplica il filtro. Il confronto è sulla stessa data mostrata in griglia
    /// ed è inclusivo su entrambi gli estremi.
    /// </summary>
    private void AggiornaFiltro()
    {
        if (!FiltroAttivo)
        {
            LogFiltrati = ListaLog;
            return;
        }

        LogFiltrati = ListaLog.Where(l =>
        {
            if (_stato.HasValue && l.stato != _stato.Value) return false;

            var giorno = l.data_creazione.Date;
            if (_da.HasValue && giorno < _da.Value.Date) return false;
            if (_a.HasValue && giorno > _a.Value.Date) return false;
            return true;
        }).ToList();
    }

    private void OnStatoChanged(ChangeEventArgs e)
    {
        var valore = e.Value?.ToString();
        _stato = int.TryParse(valore, out var s) ? s : null;
        AggiornaFiltro();
    }

    /// <summary>Imposta il filtro sul mese indicato: 0 = corrente, -1 = precedente.</summary>
    private void ImpostaMese(int scostamento)
    {
        var primo = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(scostamento);
        _da = primo;
        _a = primo.AddMonths(1).AddDays(-1);
        AggiornaFiltro();
    }

    /// <summary>Riporta i filtri ai valori iniziali: nessun periodo, stato 1.</summary>
    private void PulisciFiltro()
    {
        _da = null;
        _a = null;
        _stato = 1;
        AggiornaFiltro();
    }

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated) { Nav.NavigateTo("/login"); return; }

        _logService = Factory.Logs();
    }

    // Il caricamento avviene dopo il primo render, quando i @ref dei dialog sono valorizzati
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Session.IsAuthenticated) return;

        await CaricaDati();
        StateHasChanged();
    }

    /// <summary>Replica di LogForms.CaricaDati() — ordinamento discendente per data.</summary>
    private async Task CaricaDati()
    {
        try
        {
            _busy = true;
            var lista = await _logService.GetAllAsync();
            ListaLog = (lista ?? new List<EmmaLog>()).OrderByDescending(x => x.data_creazione).ToList();
        }
        catch (Exception ex)
        {
            ListaLog = new();
            await _dialogs.ErroreAsync(ex.Message);
        }
        finally
        {
            AggiornaFiltro();
            _busy = false;
        }
    }
}
