@page "/login"
@layout MainLayout
@inject UserSession Session
@inject EmmaServiceFactory Factory
@inject NavigationManager Nav
@implements IDisposable

@* Schermata di accesso: pannello di presentazione + form credenziali.
   Il pannello di sinistra ruota fra più slide, una ogni 3 secondi. *@

<div class="login-shell @(_busy ? "busy" : "")">

    <div class="login-hero">
        <div class="login-hero-top">
            <EmmaLogo Variant="invert" Class="emma-logo lg" />
            <span class="emma-brand-text light">
                <b>EMMA</b>
                <span>Doc Platform</span>
            </span>
        </div>

        <div class="login-hero-body login-slides">
            @* @key sull'indice: cambiando slide Blazor ricrea il nodo e l'animazione riparte *@
            <div class="login-slide" @key="_slide">
                <h2>@((MarkupString)Slides[_slide].Titolo)</h2>
                <ul class="login-points">
                    @foreach (var p in Slides[_slide].Punti)
                    {
                        <li><EmmaIcon Name="@p.Icona" /> @p.Testo</li>
                    }
                </ul>
            </div>

            <div class="login-dots">
                @for (var i = 0; i < Slides.Length; i++)
                {
                    var indice = i;
                    <button type="button" class="login-dot @(indice == _slide ? "on" : "")"
                            aria-label="@($"Mostra la slide {indice + 1} di {Slides.Length}")"
                            @onclick="() => VaiAllaSlide(indice)"></button>
                }
            </div>
        </div>

        <div class="login-hero-foot">© @DateTime.Now.Year EMMA Doc Platform</div>
    </div>

    <div class="login-panel">
        <div class="login-card">
            <h1>Accedi</h1>
            <p class="login-sub">Inserisci le tue credenziali per entrare nel client.</p>

            <div class="login-field">
                <label for="txtUser">Utente</label>
                <span class="input-wrap">
                    <EmmaIcon Name="user" Class="lead" />
                    <input id="txtUser" class="emma-input input-lg" type="text" autocomplete="username"
                           placeholder="Inserisci l'utente"
                           @bind="_user" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_busy" />
                </span>
            </div>

            <div class="login-field">
                <label for="txtPassword">Password</label>
                <span class="input-wrap">
                    <EmmaIcon Name="lock" Class="lead" />
                    <input id="txtPassword" class="emma-input input-lg has-trail" autocomplete="current-password"
                           type="@(_mostraPassword ? "text" : "password")" placeholder="Inserisci la password"
                           @bind="_password" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_busy" />
                    <button class="pwd-toggle" type="button" tabindex="-1"
                            title="@(_mostraPassword ? "Nascondi la password" : "Mostra la password")"
                            aria-label="Mostra o nascondi la password" @onclick="TogglePassword">
                        <EmmaIcon Name="@(_mostraPassword ? "eye-off" : "eye")" />
                    </button>
                </span>
            </div>

            <button class="btn btn-blue btn-lg" @onclick="BtnOk_Click" disabled="@_busy">
                @if (_busy)
                {
                    <span class="emma-spinner"></span>
                    <span>Accesso in corso…</span>
                }
                else
                {
                    <span>Accedi</span>
                }
            </button>

            <button class="btn-link" type="button" @onclick="BtnCancel_Click" disabled="@_busy">Pulisci i campi</button>
        </div>
    </div>
</div>

<EmmaDialogs @ref="_dialogs" />

@code {
    private bool _mostraPassword;

    private void TogglePassword() => _mostraPassword = !_mostraPassword;

    // ---- Slide rotanti del pannello di presentazione ----

    private sealed record Punto(string Icona, string Testo);
    private sealed record Slide(string Titolo, Punto[] Punti);

    /// <summary>Ogni quanto cambia la slide.</summary>
    private static readonly TimeSpan IntervalloSlide = TimeSpan.FromSeconds(6);

    // Il titolo è reso come MarkupString: qui è ammesso solo <br /> per mandare a capo.
    private static readonly Slide[] Slides =
    [
        new("I tuoi documenti sotto controllo,<br />dal caricamento alla conciliazione.",
        [
            new("upload",  "Acquisizione di bolle e fatture da PDF o XML"),
            new("compare", "Conciliazione tra ordini, bolle e fatture"),
            new("ai",      "Procedure eseguite con l'ausilio di Intelligenza Artificiale")
        ]),
        new("Archivio documentale sempre a portata,<br />ricerca in pochi istanti.",
        [
            new("search", "Ricerca utilizzando il linguaggio naturale"),
            new("files",  "Anteprima dei PDF direttamente dal browser"),
            new("box",    "Informazioni a portata di mano in qualsiasi momento")
        ]),
        new("I tuoi dati al sicuro,<br />con tracciabilità completa.",
        [
            new("shield", "Accesso riservato agli utenti abilitati"),
            new("log",    "Log delle operazioni consultabile in ogni momento"),
            new("key",    "Sicurezza e privacy dei dati.")
        ])
    ];

    private int _slide;
    private System.Threading.Timer? _timerSlide;

    private void VaiAllaSlide(int indice)
    {
        _slide = indice;
        FaiRipartireIlTimer();
    }

    /// <summary>Dopo un click manuale la slide scelta resta visibile per l'intervallo pieno.</summary>
    private void FaiRipartireIlTimer() => _timerSlide?.Change(IntervalloSlide, IntervalloSlide);

    public void Dispose() => _timerSlide?.Dispose();

    private string _user = string.Empty;
    private string _password = string.Empty;
    private bool _busy;
    private EmmaDialogs _dialogs = default!;

    protected override void OnInitialized()
    {
        // Session già attiva: salta il login
        if (Session.IsAuthenticated)
        {
            Nav.NavigateTo("/dashboard");
        }
    }

    // Il timer parte solo sul circuito interattivo (non durante il prerendering)
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _timerSlide is not null) return;

        _timerSlide = new System.Threading.Timer(_ =>
        {
            _slide = (_slide + 1) % Slides.Length;

            // Il callback arriva da un thread del pool: il render va rimandato al circuito
            InvokeAsync(StateHasChanged);
        }, null, IntervalloSlide, IntervalloSlide);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BtnOk_Click();
    }

    /// <summary>Replica di Login.IfLoginSucceded()</summary>
    private async Task<(bool esito, string userCode)> IfLoginSucceded(string user, string password)
    {
        var loginService = Factory.Login(user, password);
        var loginResponse = await loginService.LoginAsync();

        if (loginResponse is null) return (false, string.Empty);
            
        if (!string.IsNullOrWhiteSpace(loginResponse.url))
        {
            // Nel desktop veniva salvato su config.json; qui resta nella sessione utente
            Session.ServerUrlOverride = loginResponse.url;
        }

        return (loginResponse.esito, loginResponse.userCode);
    }

    private async Task BtnOk_Click()
    {
        if (string.IsNullOrWhiteSpace(_user))
        {
            await _dialogs.ErroreAsync("Inserire Utente!");
            return;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            await _dialogs.ErroreAsync("Inserire Password!");
            return;
        }

        try
        {
            _busy = true;
            StateHasChanged();

            var (ok, userCode) = await IfLoginSucceded(_user, _password);

            if (ok)
            {
                // usa userCode se restituito, altrimenti fallback a "marco" come prima
                Session.SignIn(_user, _password, string.IsNullOrEmpty(userCode) ? string.Empty : userCode);

                // Ping opzionale per "svegliare" il server free tier
                try
                {
                    await Factory.Docs().PingAsync();
                }
                catch
                {
                    // ignorato come nell'originale
                }

                Nav.NavigateTo("/dashboard");
            }
            else
            {
                await _dialogs.ErroreAsync("Credenziali errate !");
                _password = string.Empty;
            }
        }
        catch (Exception ex)
        {
            await _dialogs.ErroreAsync(ex.Message);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void BtnCancel_Click()
    {
        _user = string.Empty;
        _password = string.Empty;
    }
}
