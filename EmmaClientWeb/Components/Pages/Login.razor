@page "/login"
@layout MainLayout
@inject UserSession Session
@inject EmmaServiceFactory Factory
@inject NavigationManager Nav

@* Schermata di accesso: pannello di presentazione + form credenziali. *@

<div class="login-shell @(_busy ? "busy" : "")">

    <div class="login-hero">
        <div class="login-hero-top">
            <EmmaLogo Variant="invert" Class="emma-logo lg" />
            <span class="emma-brand-text light">
                <b>EMMA</b>
                <span>Doc Platform</span>
            </span>
        </div>

        <div class="login-hero-body">
            <h2>I tuoi documenti sotto controllo,<br />dal caricamento alla conciliazione.</h2>
            <ul class="login-points">
                <li><EmmaIcon Name="upload" /> Acquisizione di bolle e fatture da PDF o XML</li>
                <li><EmmaIcon Name="compare" /> Conciliazione tra ordini, bolle e fatture</li>
                <li><EmmaIcon Name="ai" /> Procedure eseguite con l'ausilio di Intelligenza Artificiale</li>
            </ul>
        </div>

        <div class="login-hero-foot">© @DateTime.Now.Year EMMA Doc Platform</div>
    </div>

    <div class="login-panel">
        <div class="login-card">
            <h1>Accedi</h1>
            <p class="login-sub">Inserisci le tue credenziali per entrare nel client.</p>

            <div class="login-field">
                <label for="txtUser">Utente</label>
                <span class="input-wrap">
                    <EmmaIcon Name="user" Class="lead" />
                    <input id="txtUser" class="emma-input input-lg" type="text" autocomplete="username"
                           placeholder="Inserisci l'utente"
                           @bind="_user" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_busy" />
                </span>
            </div>

            <div class="login-field">
                <label for="txtPassword">Password</label>
                <span class="input-wrap">
                    <EmmaIcon Name="lock" Class="lead" />
                    <input id="txtPassword" class="emma-input input-lg has-trail" autocomplete="current-password"
                           type="@(_mostraPassword ? "text" : "password")" placeholder="Inserisci la password"
                           @bind="_password" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_busy" />
                    <button class="pwd-toggle" type="button" tabindex="-1"
                            title="@(_mostraPassword ? "Nascondi la password" : "Mostra la password")"
                            aria-label="Mostra o nascondi la password" @onclick="TogglePassword">
                        <EmmaIcon Name="@(_mostraPassword ? "eye-off" : "eye")" />
                    </button>
                </span>
            </div>

            <button class="btn btn-blue btn-lg" @onclick="BtnOk_Click" disabled="@_busy">
                @if (_busy)
                {
                    <span class="emma-spinner"></span>
                    <span>Accesso in corso…</span>
                }
                else
                {
                    <span>Accedi</span>
                }
            </button>

            <button class="btn-link" type="button" @onclick="BtnCancel_Click" disabled="@_busy">Pulisci i campi</button>
        </div>
    </div>
</div>

<EmmaDialogs @ref="_dialogs" />

@code {
    private bool _mostraPassword;

    private void TogglePassword() => _mostraPassword = !_mostraPassword;

    private string _user = string.Empty;
    private string _password = string.Empty;
    private bool _busy;
    private EmmaDialogs _dialogs = default!;

    protected override void OnInitialized()
    {
        // Session già attiva: salta il login
        if (Session.IsAuthenticated)
        {
            Nav.NavigateTo("/dashboard");
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BtnOk_Click();
    }

    /// <summary>Replica di Login.IfLoginSucceded()</summary>
    private async Task<(bool esito, string userCode)> IfLoginSucceded(string user, string password)
    {
        var loginService = Factory.Login(user, password);
        var loginResponse = await loginService.LoginAsync();

        if (loginResponse is null) return (false, string.Empty);
            
        if (!string.IsNullOrWhiteSpace(loginResponse.url))
        {
            // Nel desktop veniva salvato su config.json; qui resta nella sessione utente
            Session.ServerUrlOverride = loginResponse.url;
        }

        return (loginResponse.esito, loginResponse.userCode);
    }

    private async Task BtnOk_Click()
    {
        if (string.IsNullOrWhiteSpace(_user))
        {
            await _dialogs.ErroreAsync("Inserire Utente!");
            return;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            await _dialogs.ErroreAsync("Inserire Password!");
            return;
        }

        try
        {
            _busy = true;
            StateHasChanged();

            var (ok, userCode) = await IfLoginSucceded(_user, _password);

            if (ok)
            {
                // usa userCode se restituito, altrimenti fallback a "marco" come prima
                Session.SignIn(_user, _password, string.IsNullOrEmpty(userCode) ? string.Empty : userCode);

                // Ping opzionale per "svegliare" il server free tier
                try
                {
                    await Factory.Docs().PingAsync();
                }
                catch
                {
                    // ignorato come nell'originale
                }

                Nav.NavigateTo("/dashboard");
            }
            else
            {
                await _dialogs.ErroreAsync("Credenziali errate !");
                _password = string.Empty;
            }
        }
        catch (Exception ex)
        {
            await _dialogs.ErroreAsync(ex.Message);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void BtnCancel_Click()
    {
        _user = string.Empty;
        _password = string.Empty;
    }
}
