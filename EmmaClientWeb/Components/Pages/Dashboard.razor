@page "/dashboard"
@layout MainLayout
@inject UserSession Session
@inject NavigationManager Nav

@* Home applicativa: le operazioni raggruppate per area, stesse voci del menu laterale. *@

<div class="dash">

    <div class="dash-hero">
        <h1>Ciao, @Session.Codice</h1>
        <p>Seleziona un'operazione per iniziare, oppure usa il menu di navigazione.</p>
    </div>

    <div class="dash-section">Documenti</div>
    <div class="dash-grid">
        <a class="dash-card" href="/documenti/carica-documento">
            <span class="dash-ico"><EmmaIcon Name="doc-upload" /></span>
            <span class="dash-txt">
                <b>Carica Documento</b>
                <p>Carica un documento.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>

        <a class="dash-card" href="/documenti/ricerca">
            <span class="dash-ico"><EmmaIcon Name="search" /></span>
            <span class="dash-txt">
                <b>Ricerca</b>
                <p>Cerca tra i documenti scrivendo una domanda.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>
    </div>

    <div class="dash-section">Ordini Bolle Fatture</div>
    <div class="dash-grid">
        <a class="dash-card" href="/documenti/carica">
            <span class="dash-ico"><EmmaIcon Name="upload" /></span>
            <span class="dash-txt">
                <b>Carica Ordini Bolle Fatture</b>
                <p>Importa un Ordine, una Bolla o una Fattura da PDF o XML.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>

        <a class="dash-card" href="/documenti">
            <span class="dash-ico"><EmmaIcon Name="files" /></span>
            <span class="dash-txt">
                <b>Visualizza Ordini Bolle Fatture</b>
                <p>Gestione Ordini, Bolle e Fatture.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>
    </div>

    <div class="dash-section">Anagrafiche</div>
    <div class="dash-grid">
        <a class="dash-card" href="/fornitori">
            <span class="dash-ico tone-violet"><EmmaIcon Name="truck" /></span>
            <span class="dash-txt">
                <b>Fornitori</b>
                <p>Anagrafica fornitori: inserimento, modifica ed eliminazione.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>

        <a class="dash-card" href="/articoli">
            <span class="dash-ico tone-violet"><EmmaIcon Name="box" /></span>
            <span class="dash-txt">
                <b>Articoli</b>
                <p>Anagrafica Articoli: inserimento, modifica ed eliminazione.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>
    </div>

    <div class="dash-section">Conciliazione</div>
    <div class="dash-grid">
        <a class="dash-card" href="/conciliazione-ordini">
            <span class="dash-ico tone-green"><EmmaIcon Name="compare" /></span>
            <span class="dash-txt">
                <b>Concilia Ordini → Bolle</b>
                <p>Abbina le righe d'Ordine alle Bolle.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>

        <a class="dash-card" href="/conciliazione">
            <span class="dash-ico tone-green"><EmmaIcon Name="check-doc" /></span>
            <span class="dash-txt">
                <b>Concilia Bolle → Fatture</b>
                <p>Abbina le righe Bolle alle Fatture.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>
    </div>

    <div class="dash-section">Sistema</div>
    <div class="dash-grid">
        <a class="dash-card" href="/log">
            <span class="dash-ico tone-slate"><EmmaIcon Name="log" /></span>
            <span class="dash-txt">
                <b>Log</b>
                <p>Storico delle elaborazioni.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>

        <a class="dash-card" href="/password">
            <span class="dash-ico tone-amber"><EmmaIcon Name="key" /></span>
            <span class="dash-txt">
                <b>Cambio Password</b>
                <p>Aggiorna la password utilizzata per l'accesso.</p>
            </span>
            <EmmaIcon Name="arrow" Class="dash-arrow" />
        </a>
    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated) Nav.NavigateTo("/login");
    }
}
