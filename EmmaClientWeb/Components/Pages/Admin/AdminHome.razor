@page "/admin/home"
@layout AdminLayout
@inject AdminSession Admin
@inject NavigationManager Nav

@* Home della sezione Admin: per ora un solo pulsante, gli altri arriveranno *@

<div class="dashboard">
    <div class="dashboard-header">
        <h1>Amministrazione</h1>
        <p>Seleziona un'operazione per iniziare</p>
    </div>

    <div class="dashboard-grid admin-grid">
        <a class="dashboard-card" href="/admin/tenant">
            @* Icona inline: segue il colore del testo e non aggiunge richieste HTTP *@
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"
                 width="72" height="72">
                <path d="M3 21h18" />
                <path d="M5 21V6l7-3v18" />
                <path d="M12 21V9l7 2v10" />
                <path d="M8 8h1M8 11h1M8 14h1M15 13h1M15 16h1" />
            </svg>
            <span>Tenants</span>
        </a>

        <a class="dashboard-card" href="/admin/users">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"
                 width="72" height="72">
                <circle cx="9" cy="8" r="3.5" />
                <path d="M2.5 20c0-3.6 2.9-6.5 6.5-6.5s6.5 2.9 6.5 6.5" />
                <path d="M16.5 5.6a3.5 3.5 0 0 1 0 6.8" />
                <path d="M18 13.9c2.1.8 3.5 2.8 3.5 5.1" />
            </svg>
            <span>Users</span>
        </a>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Admin.IsAuthenticated) Nav.NavigateTo("/admin");
    }
}
