@page "/conciliazione"
@layout MainLayout

@* Conciliazione Bolle / DDT -> Fatture.
   Tutta la GUI e la logica stanno in Components/Shared/ConciliazioneView.razor:
   qui si dichiarano solo i parametri di questa variante. *@

<ConciliazioneView Chiave="BOLLE-FATTURE"
                   TitoloSinistra="Bolle / DDT"
                   TipiDocSinistra="@TipiSinistra"
                   FiltraDateSinistra="true"
                   NomeRigheSinistra="bolla"
                   TestoVuotoSinistra="@VuotoSinistra"
                   TitoloDestra="Fatture"
                   TipiDocDestra="@TipiDestra"
                   FiltraDateDestra="true"
                   NomeRigheDestra="fattura"
                   TestoVuotoDestra="@VuotoDestra" />

@code {
    // Griglia di sinistra: DDT / bolle
    private static readonly int[] TipiSinistra =
    {
        ConciliazioneView.TipiDoc.Ddt
    };

    // Griglia di destra: fatture + fatture accompagnatorie
    private static readonly int[] TipiDestra =
    {
        ConciliazioneView.TipiDoc.Fattura,
        ConciliazioneView.TipiDoc.FatturaAccompagnatoria
    };

    private const string VuotoSinistra = "Imposta i filtri e premi \"Carica Dati\" per caricare le bolle.";
    private const string VuotoDestra = "Imposta i filtri e premi \"Carica Dati\" per caricare le fatture.";
}
