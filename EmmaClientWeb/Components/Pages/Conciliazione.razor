    /// <summary>
    /// Pulsante "Concilia": match esatto in .NET + fuzzy via Python su non-matching.
    /// </summary>
    private async Task ProponiConciliazione_Click()
    {
        // var righeBolle = Bolle.Where(r => r.Selezionato).ToList();
        // var righeFatture = Fatture.Where(r => r.Selezionato).ToList();

        var righeBolle = Bolle.ToList();
        var righeFatture = Fatture.ToList();

        #if !DEBUG
