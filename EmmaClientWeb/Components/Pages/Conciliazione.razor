    {
    await _dialogs.ErroreAsync("Selezionare almeno una riga in ciascuna griglia.");
    return;
    }
        #endif

        if (!await _dialogs.ConfermaAsync($"Conciliare {righeBolle.Count} righe bolla con {righeFatture.Count} righe fattura?")) return;

        try
        {
            _busy = true;

            List<ConciliazioneResponse> ret = await _conciliazioneService.GetConciliazione("BOLLE-FATTURE", righeBolle, righeFatture);

            var s = $"✓ Conciliato:";
            ret.ForEach(x =>
            {
                string fornitore = x.Document.Fornitore;

                var bolleGrid = Bolle.Where(x => x.Fornitore == fornitore).ToList();
                var fattureGrid = Fatture.Where(x => x.Fornitore == fornitore).ToList();

                var b = x.Document.BolleNonConciliate.Count();
                var f = x.Document.FattureNonConciliate.Count();
                var c = x.Document.Conciliazioni.Count();

                s += $"\n\n" +
                     $"Fornitore: {fornitore}\n" +
                     $"Bolle non conciliate: {b}\n" +
                     $"Fatture non conciliate: {f}\n" +
                     $"Conciliazioni proposte: {c}";


                foreach (var n in x.Document.BolleNonConciliate)
                {
                    var id_bolla_non = n.Id;
                    var codide_bolla_non = n.Codice;
                    var qta_bolla_non = n.Qta;                    
                }

                foreach (var m in x.Document.FattureNonConciliate)
                {
                    var id_fattura_non = m.Id;
                    var r = fattureGrid.Where(x => x.IdRiga == id_fattura_non).FirstOrDefault();
                    if (r is not null)
                    {
                        r.Note = "";
                        r.Stato = "NON_CONCILIATA";
                    }
                    var codide_fattura_non = m.Codice;
                    var qta_fattura_non = m.Qta;                    
                }

                //Ciclo per ogni riga fattura
                foreach (var conc in x.Document.Conciliazioni)
                {
                    var stato_conc = conc.StatoConciliazione;
                    var note = conc.Note;

                    var diff = conc.DifferenzaQta;
                    var totale = conc.TotaleQtaBolle;

                    var id_fattura = conc.Fattura.Id;
                    
                    var r = fattureGrid.Where(x=>x.IdRiga == id_fattura).FirstOrDefault();
                    if (r is not null) {
                        if (conc.DifferenzaQta == 0) r.Selezionato = true;
                        r.Qta_Conc = conc.TotaleQtaBolle;
                        r.Note = conc.Note;
                        r.Stato = conc.StatoConciliazione;
                    }

                    var cod_fattura = conc.Fattura.Codice;
                    var qta_fattura = conc.Fattura.Qta;

                    var bolle_collegate = conc.BolleCollegate;
                    foreach (var bolla in bolle_collegate)
                    {
                        var id_bolla = bolla.Id;
                        var s = bolleGrid.Where(x => x.IdRiga == id_bolla).FirstOrDefault();
                        if (s is not null) {
                            s.Selezionato = true;
                            s.Qta_Conc = bolla.Qta;
                        }

                        var score_bolla = bolla.FuzzyScore;
                        var qta_bolla = bolla.Qta;
                        var codice_orig_bolla = bolla.CodiceOriginale;                        
                    }
                }
            });

            await _dialogs.InfoAsync(s);
        }
        catch (Exception ex)
        {
            await _dialogs.ErroreAsync(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }


