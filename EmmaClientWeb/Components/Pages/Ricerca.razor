@page "/documenti/ricerca"
@layout MainLayout
@using EmmaServer.Entities.Dtos
@using Emma.Services.Services
@inject UserSession Session
@inject EmmaServiceFactory Factory
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Ricerca semantica sul database vettoriale.
   POST /api/v1/document/search: la domanda viene vettorizzata con taskType
   RETRIEVAL_QUERY e confrontata con i chunk tramite distanza coseno. *@

<div class="emma-page chat-page">

    <div class="chat-log" id="chat-log">
        @if (_messaggi.Count == 0)
        {
            <div class="chat-empty">
                <EmmaIcon Name="search" />
                <b>Cosa vuoi cercare?</b>
                <p>Scrivi una domanda in linguaggio naturale e premi Invio.</p>
            </div>
        }

        @foreach (var m in _messaggi)
        {
            <div class="chat-row @(m.Utente ? "mine" : "")">
                <span class="chat-avatar">@(m.Utente ? Iniziale : "E")</span>
                <div class="chat-bubble">
                    <span class="chat-text">@m.Testo</span>

                    @if (m.Fonti is { Count: > 0 } fonti)
                    {
                        <div class="rag-fonti">
                            @for (int i = 0; i < fonti.Count; i++)
                            {
                                var f = fonti[i];
                                var n = i + 1;
                                <div class="rag-fonte">
                                    <div class="rag-fonte-head">
                                        <span class="rag-fonte-num">[@n]</span>
                                        <span class="rag-fonte-file" title="@f.FileName">@f.FileName</span>
                                        <span class="rag-fonte-pag">pag. @f.Page</span>
                                        <span class="rag-fonte-score" title="Similarità coseno">@f.Score.ToString("P0")</span>
                                        <button class="btn btn-mini btn-dodger" title="Apri il PDF"
                                                @onclick="() => ApriPdf(f)" disabled="@_busy">📄</button>
                                    </div>
                                    <div class="rag-fonte-testo">@f.Content</div>
                                </div>
                            }
                        </div>
                    }

                    <span class="chat-time">@m.Ora.ToString("HH:mm")</span>
                </div>
            </div>
        }

        @if (_busy)
        {
            <div class="chat-row">
                <span class="chat-avatar">E</span>
                <div class="chat-bubble">
                    <span class="chat-typing"><i></i><i></i><i></i></span>
                </div>
            </div>
        }
    </div>

    <div class="chat-params">
        <label>
            Risultati
            <select class="emma-input" @bind="_topK" disabled="@_busy">
                <option value="3">3</option>
                <option value="5">5</option>
                <option value="10">10</option>
            </select>
        </label>

        <label>
            Rilevanza minima
            <select class="emma-input" @bind="_minScoreSel" disabled="@_busy">
                <option value="0">nessuna</option>
                <option value="0.5">50%</option>
                <option value="0.65">65%</option>
                <option value="0.8">80%</option>
            </select>
        </label>
    </div>

    <div class="chat-composer">
        <input class="emma-input chat-input" placeholder="Scrivi la tua richiesta..."
               @bind="_testo" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@_busy" />

        <button class="btn btn-blue" @onclick="Invia" disabled="@(_busy || string.IsNullOrWhiteSpace(_testo))">
            <span>➤</span><span>Invia</span>
        </button>

        <button class="btn btn-grey" @onclick="Pulisci" disabled="@(_busy || _messaggi.Count == 0)">
            <span>✖</span><span>Pulisci</span>
        </button>
    </div>
</div>

<PdfViewer @ref="_pdfViewer" />
<EmmaDialogs @ref="_dialogs" />

@code {
    private sealed record Messaggio(bool Utente, string Testo, DateTime Ora, List<RagSearchResult>? Fonti = null);

    private readonly List<Messaggio> _messaggi = new();
    private string _testo = string.Empty;
    private bool _busy;

    private int _topK = 5;

    // Legata come stringa e convertita in cultura invariante: con it-IT il binding
    // diretto su double leggerebbe "0.5" come 5.
    private string _minScoreSel = "0";

    private double MinScore =>
        double.TryParse(_minScoreSel, NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : 0;

    private EmmaDialogs _dialogs = default!;
    private PdfViewer _pdfViewer = default!;
    private IRagServiceClient _rag = default!;

    private string Iniziale => string.IsNullOrWhiteSpace(Session.User)
        ? "?"
        : Session.User.Trim()[..1].ToUpperInvariant();

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        _rag = Factory.Rag();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await Invia();
    }

    private async Task Invia()
    {
        var domanda = _testo.Trim();
        if (domanda.Length == 0 || _busy) return;

        _messaggi.Add(new Messaggio(true, domanda, DateTime.Now));
        _testo = string.Empty;
        _busy = true;
        await ScrollInFondo();

        try
        {
            // La soglia a 0 vuol dire "nessun filtro": si passa null al server
            double? soglia = MinScore > 0 ? MinScore : null;

            var risultati = await _rag.CercaAsync(domanda, _topK, minScore: soglia);

            if (risultati.Count == 0)
            {
                _messaggi.Add(new Messaggio(false,
                    soglia is null
                        ? "Non ho trovato nulla nei documenti indicizzati."
                        : $"Nessun passaggio sopra la soglia del {soglia:P0}. Prova ad abbassare la rilevanza minima.",
                    DateTime.Now));
            }
            else
            {
                int documenti = risultati.Select(r => r.DocId).Distinct().Count();

                string intestazione = documenti == 1
                    ? $"Ho trovato {risultati.Count} passaggi in 1 documento:"
                    : $"Ho trovato {risultati.Count} passaggi in {documenti} documenti:";

                _messaggi.Add(new Messaggio(false, intestazione, DateTime.Now, risultati));
            }
        }
        catch (Exception ex)
        {
            _messaggi.Add(new Messaggio(false, $"Ricerca non riuscita: {ex.Message}", DateTime.Now));
        }
        finally
        {
            _busy = false;
            await ScrollInFondo();
        }
    }

    private async Task ApriPdf(RagSearchResult fonte)
    {
        try
        {
            _busy = true;
            StateHasChanged();

            var bytes = await _rag.ScaricaPdfAsync(fonte.DocId);
            if (bytes is null || bytes.Length == 0)
            {
                await _dialogs.InfoAsync($"Nessun PDF allegato per \"{fonte.FileName}\".");
                return;
            }

            _pdfViewer.Mostra(bytes, fonte.FileName);
        }
        catch (Exception ex)
        {
            await _dialogs.ErroreAsync(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Pulisci()
    {
        _messaggi.Clear();
        _testo = string.Empty;
    }

    private async Task ScrollInFondo()
    {
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("emma.scrollToBottom", "chat-log");
        }
        catch
        {
            // il prerender non ha ancora il DOM: ininfluente
        }
    }
}
