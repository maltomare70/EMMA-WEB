@page "/password"
@layout MainLayout
@inject UserSession Session
@inject EmmaServiceFactory Factory
@inject NavigationManager Nav

@* Replica di Forms/Password/PwdForm.axaml - Window 350x250 *@

<div class="emma-page @(_busy ? "busy" : "")">
    <div class="pwd-window">

        <div class="group">
            <label for="newPwd">Nuova Password:</label>
            <input id="newPwd" class="emma-input" type="password" placeholder="Inserisci la nuova password"
                   @bind="_nuovaPassword" @bind:event="oninput" disabled="@_busy" />
        </div>

        <div class="group">
            <label for="confPwd">Conferma Password:</label>
            <input id="confPwd" class="emma-input" type="password" placeholder="Ripeti la nuova password"
                   @bind="_confermaPassword" @bind:event="oninput" disabled="@_busy" />
        </div>

        <div class="pwd-actions">
            <button class="btn btn-default" @onclick="Esegui_Click" disabled="@_busy">Esegui</button>
            <button class="btn btn-default" @onclick="Annulla_Click" disabled="@_busy">Annulla</button>
        </div>

    </div>
</div>

<EmmaDialogs @ref="_dialogs" />

@code {
    private string _nuovaPassword = string.Empty;
    private string _confermaPassword = string.Empty;
    private bool _busy;
    private EmmaDialogs _dialogs = default!;

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated) Nav.NavigateTo("/login");
    }

    /// <summary>Replica di PwdForm.Esegui_Click</summary>
    private async Task Esegui_Click()
    {
        if (string.IsNullOrWhiteSpace(_nuovaPassword))
        {
            await _dialogs.ErroreAsync("Inserire Password !");
            return;
        }

        if (_nuovaPassword != _confermaPassword)
        {
            await _dialogs.ErroreAsync("Password non coincidenti !");
            return;
        }

        if (!PasswordValidator.IsPasswordValid(_nuovaPassword))
        {
            await _dialogs.ErroreAsync(
                "La password deve essere lunga almeno 8 caratteri, contenere almeno una lettera maiuscola, un numero e un carattere speciale.");
            return;
        }

        try
        {
            _busy = true;

            var userService = Factory.Users();
            var esito = await userService.CambiaPasswordAsync(new CambiaPasswordRequest
            {
                email = Session.User,
                oldPassword = Session.Password,
                newPassword = _nuovaPassword
            });

            if (esito == 1)
            {
                // Le chiamate successive usano l'autenticazione Basic: aggiorniamo la sessione
                Session.UpdatePassword(_nuovaPassword);

                await _dialogs.InfoAsync("Password cambiata con successo !");
                Nav.NavigateTo("/dashboard");
            }
            else
            {
                await _dialogs.ErroreAsync("Cambio password non riuscito.");
            }
        }
        catch (Exception ex)
        {
            await _dialogs.ErroreAsync(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Annulla_Click() => Nav.NavigateTo("/dashboard");
}
