@using System.Globalization
@using EmmaServer.Entities.Dtos

@* Una delle due griglie della conciliazione: drilldown fornitore -> documento -> riga articolo.
   E' lo stesso markup per la griglia di sinistra e per quella di destra; l'unica differenza
   strutturale e' la colonna icona + le colonne Stato/Note, attivate da ConStatoENote.
   Lo stato di apertura dei gruppi e' interno al componente: il padre passa solo le righe. *@

<div class="conc-pane">
    <div class="conc-pane-title">
        <span>@Titolo</span>
        <span class="conc-title-right">
            <button class="btn-mini" type="button"
                    @onclick="ToggleTuttiGruppi"
                    disabled="@(Busy || Righe.Count == 0)">
                @(TuttiAperti() ? "Comprimi tutto" : "Espandi tutto")
            </button>
            <span class="conc-badge">@Selezionate / @Righe.Count selezionate</span>
        </span>
    </div>

    <div class="emma-grid-wrapper">
        <table class="emma-grid">
            <thead>
                <tr>
                    <th style="width:52px" class="cell-center">
                        <input type="checkbox"
                               checked="@(Righe.Count > 0 && Selezionate == Righe.Count)"
                               @onchange="e => SelezionaTutto(e.Value is true)"
                               disabled="@(Busy || Righe.Count == 0)" />
                        <div class="conc-th-sub"></div>
                    </th>
                    @if (ConStatoENote)
                    {
                        <th style="width:34px" class="cell-center" title="Stato conciliazione"></th>
                    }
                    <th style="min-width:150px">Fornitore</th>
                    <th style="width:130px">Numero Documento</th>
                    <th style="width:115px">Data Documento</th>
                    <th style="width:130px">Codice Articolo</th>
                    <th style="min-width:180px">Descrizione Articolo</th>
                    <th style="width:90px" class="cell-right">Quantità</th>
                    <th style="width:90px" class="cell-right">Qtà Conc.</th>
                    @if (ConStatoENote)
                    {
                        <th style="width:110px">Stato</th>
                        <th style="min-width:160px">Note</th>
                    }
                    <th style="width:150px">Cod. Abbinamento</th>
                </tr>
            </thead>
            <tbody>
                @if (Righe.Count == 0)
                {
                    <tr>
                        <td colspan="@NumeroColonne" class="empty-state">
                            @TestoVuoto
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var gruppo in RaggruppaPerFornitore(Righe))
                    {
                        var g = gruppo;
                        var aperto = _aperte.Fornitori.Contains(g.Key);
                        var totali = g.Count();
                        var selezionate = g.Count(x => x.Selezionato);

                        <tr @key="@("f-" + g.Key)" class="group-row @(aperto ? "open" : "")">
                            <td class="cell-center">
                                <input type="checkbox"
                                       checked="@(selezionate == totali)"
                                       @onchange="e => SelezionaGruppo(g, e.Value is true)"
                                       disabled="@Busy" />
                            </td>
                            @if (ConStatoENote)
                            {
                                <td class="cell-center">@IconaStato(StatoGruppo(g))</td>
                            }
                            <td colspan="5" @onclick="() => ToggleFornitore(g.Key)">
                                <span class="expander">@(aperto ? "▼" : "►")</span>
                                <span class="group-title">@NomeGruppo(g.Key)</span>
                                <span class="group-count">
                                    @NumeroDocumenti(g) documenti · @totali righe · @selezionate selezionate
                                </span>
                            </td>
                            <td class="cell-right"></td>
                            <td class="cell-right"></td>
                            @if (ConStatoENote)
                            {
                                <td></td>
                                <td></td>
                            }
                            <td></td>
                        </tr>

                        if (aperto)
                        {
                            foreach (var documento in RaggruppaPerDocumento(g))
                            {
                                var d = documento;
                                var chiaveDoc = ChiaveDocumento(g.Key, d.Key);
                                var docAperto = _aperte.Documenti.Contains(chiaveDoc);
                                var docTotali = d.Count();
                                var docSelezionate = d.Count(x => x.Selezionato);

                                <tr @key="@("d-" + chiaveDoc)" class="doc-row @(docAperto ? "open" : "")">
                                    <td class="cell-center">
                                        <input type="checkbox"
                                               checked="@(docSelezionate == docTotali)"
                                               @onchange="e => SelezionaGruppo(d, e.Value is true)"
                                               disabled="@Busy" />
                                    </td>
                                    @if (ConStatoENote)
                                    {
                                        <td class="cell-center">@IconaStato(StatoGruppo(d))</td>
                                    }
                                    <td class="cell-child"></td>
                                    <td @onclick="() => ToggleDocumento(chiaveDoc)">
                                        <span class="expander">@(docAperto ? "▼" : "►")</span>
                                        <span class="group-title">@NomeDocumento(d.Key)</span>
                                    </td>
                                    <td @onclick="() => ToggleDocumento(chiaveDoc)">
                                        @d.First().DataDocumento
                                    </td>
                                    <td colspan="2" @onclick="() => ToggleDocumento(chiaveDoc)">
                                        <span class="group-count">
                                            @docTotali righe · @docSelezionate selezionate
                                        </span>
                                    </td>
                                    <td class="cell-right"></td>
                                    <td class="cell-right"></td>
                                    @if (ConStatoENote)
                                    {
                                        <td></td>
                                        <td></td>
                                    }
                                    <td></td>
                                </tr>

                                if (docAperto)
                                {
                                    foreach (var riga in RigheVisibili(d))
                                    {
                                        var r = riga;
                                        <tr @key="r" class="child-row @(r.Selezionato ? "selected" : "")">
                                            <td class="cell-center">
                                                <input type="checkbox" checked="@r.Selezionato"
                                                       @onchange="e => CambiaSelezione(r, e.Value is true)"
                                                       disabled="@Busy" />
                                            </td>
                                            @if (ConStatoENote)
                                            {
                                                <td class="cell-center">@IconaStato(r.Stato)</td>
                                            }
                                            <td class="cell-child"></td>
                                            <td class="cell-child"></td>
                                            <td class="cell-child"></td>
                                            <td>@r.CodiceArticolo</td>
                                            <td>@r.DescrizioneArticolo</td>
                                            <td class="cell-right">@(Qta(r.Qta))</td>
                                            <td class="cell-right">@(Qta(r.Qta_Conc))</td>
                                            @if (ConStatoENote)
                                            {
                                                <td>@r.Stato</td>
                                                <td>
                                                    <input type="text" class="cell-edit"
                                                           value="@r.Note"
                                                           @onchange="e => CambiaNota(r, e.Value?.ToString())"
                                                           disabled="@Busy" />
                                                </td>
                                            }
                                            <td>
                                                <input type="text" class="cell-edit"
                                                       value="@r.CodiceAbbinamento"
                                                       @onchange="e => CambiaCodiceAbbinamento(r, e.Value?.ToString())"
                                                       disabled="@Busy" />
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    /// <summary>Titolo mostrato in testa al pannello (es. "Ordini", "Bolle / DDT", "Fatture").</summary>
    [Parameter, EditorRequired] public string Titolo { get; set; } = string.Empty;

    /// <summary>Righe da mostrare. La lista e' condivisa con il padre: la selezione e le
    /// modifiche (note, codice abbinamento) vengono scritte direttamente sugli oggetti riga.</summary>
    [Parameter, EditorRequired] public List<RigaConciliazione> Righe { get; set; } = new();

    /// <summary>Testo mostrato quando non ci sono righe caricate.</summary>
    [Parameter] public string TestoVuoto { get; set; } = string.Empty;

    /// <summary>True per la griglia "di destinazione": aggiunge la colonna icona di stato
    /// e le colonne Stato e Note.</summary>
    [Parameter] public bool ConStatoENote { get; set; }

    /// <summary>Disabilita i controlli durante le chiamate al server.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Filtro "Nascondi righe conciliate": nasconde le sole righe di dettaglio
    /// articolo gia' conciliate correttamente (Qta - Qta_Conc == 0).</summary>
    [Parameter] public bool NascondiConciliate { get; set; }

    /// <summary>Notifica al padre che la selezione e' cambiata (per i contatori/abilitazioni).</summary>
    [Parameter] public EventCallback OnSelezioneCambiata { get; set; }

    /// <summary>Stato di apertura del drilldown a due livelli: fornitore → documento.</summary>
    private sealed class StatoGruppi
    {
        public HashSet<string> Fornitori { get; } = new();
        public HashSet<string> Documenti { get; } = new();

        public void Clear()
        {
            Fornitori.Clear();
            Documenti.Clear();
        }
    }

    private readonly StatoGruppi _aperte = new();
    private List<RigaConciliazione>? _righeCorrenti;

    private int Selezionate => Righe.Count(r => r.Selezionato);

    private int NumeroColonne => ConStatoENote ? 12 : 9;

    /// <summary>Ad ogni nuovo caricamento (lista sostituita dal padre) si riparte
    /// con tutto chiuso, tranne quando c'è un solo fornitore.</summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_righeCorrenti, Righe)) return;

        _righeCorrenti = Righe;
        _aperte.Clear();

        var gruppi = RaggruppaPerFornitore(Righe);
        if (gruppi.Count == 1) _aperte.Fornitori.Add(gruppi[0].Key);
    }

    private static string Qta(decimal v) => v.ToString("0.###", CultureInfo.CurrentCulture);

    /// <summary>Righe di dettaglio da mostrare in un gruppo documento: con il filtro
    /// "Nascondi righe conciliate" attivo esclude le righe con Qta - Qta_Conc pari a zero.</summary>
    private IEnumerable<RigaConciliazione> RigheVisibili(IEnumerable<RigaConciliazione> righe)
        => NascondiConciliate
            ? righe.Where(r => r.Qta - r.Qta_Conc != 0m)
            : righe;

    /// <summary>Stato da segnalare: valorizzato e diverso da "CONCILIATO".</summary>
    private static bool StatoDaSegnalare(string? stato)
        => !string.IsNullOrWhiteSpace(stato)
           && !string.Equals(stato.Trim(), "CONCILIATO", StringComparison.OrdinalIgnoreCase);

    /// <summary>Icona di warning mostrata quando lo stato della riga e' da segnalare.</summary>
    private static MarkupString IconaStato(string? stato)
        => !StatoDaSegnalare(stato)
            ? new MarkupString(string.Empty)
            : new MarkupString($"<span class=\"warn-icon\" title=\"{System.Net.WebUtility.HtmlEncode(stato)}\">&#9888;</span>");

    /// <summary>Stato riassuntivo di un gruppo: il primo stato da segnalare tra le righe.</summary>
    private static string StatoGruppo(IEnumerable<RigaConciliazione> righe)
        => righe.Select(r => r.Stato)
                .FirstOrDefault(StatoDaSegnalare) ?? string.Empty;

    // ---------------- Selezione ----------------

    private async Task CambiaSelezione(RigaConciliazione riga, bool valore)
    {
        riga.Selezionato = valore;
        await OnSelezioneCambiata.InvokeAsync();
    }

    private void CambiaNota(RigaConciliazione riga, string? valore)
    {
        riga.Note = valore ?? string.Empty;
    }

    /// <summary>Codice di abbinamento della riga: per ora valorizzato solo a mano / dal salvataggio.</summary>
    private void CambiaCodiceAbbinamento(RigaConciliazione riga, string? valore)
    {
        riga.CodiceAbbinamento = valore ?? string.Empty;
    }

    private async Task SelezionaTutto(bool valore)
    {
        foreach (var r in Righe) r.Selezionato = valore;
        await OnSelezioneCambiata.InvokeAsync();
    }

    private async Task SelezionaGruppo(IEnumerable<RigaConciliazione> righe, bool valore)
    {
        foreach (var r in righe) r.Selezionato = valore;
        await OnSelezioneCambiata.InvokeAsync();
    }

    // ---------------- Raggruppamento fornitore → documento (drilldown) ----------------

    /// <summary>Livello 1: righe raggruppate per fornitore, in ordine alfabetico.</summary>
    private static List<IGrouping<string, RigaConciliazione>> RaggruppaPerFornitore(List<RigaConciliazione> righe)
        => righe
            .GroupBy(r => r.Fornitore ?? string.Empty)
            .OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

    /// <summary>Livello 2: righe di un fornitore raggruppate per numero documento, in ordine di data.</summary>
    private static List<IGrouping<string, RigaConciliazione>> RaggruppaPerDocumento(IEnumerable<RigaConciliazione> righe)
        => righe
            .GroupBy(r => r.NumeroDocumento ?? string.Empty)
            .OrderBy(g => g.Min(x => x.Data) ?? DateTime.MaxValue)
            .ThenBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

    /// <summary>Chiave univoca del gruppo documento (il numero può ripetersi tra fornitori diversi).</summary>
    private static string ChiaveDocumento(string fornitore, string numeroDocumento)
        => fornitore + "||" + numeroDocumento;

    private static int NumeroDocumenti(IEnumerable<RigaConciliazione> righe)
        => righe.Select(r => r.NumeroDocumento ?? string.Empty).Distinct().Count();

    private static string NomeGruppo(string chiave)
        => string.IsNullOrWhiteSpace(chiave) ? "(fornitore non indicato)" : chiave;

    private static string NomeDocumento(string chiave)
        => string.IsNullOrWhiteSpace(chiave) ? "(senza numero)" : chiave;

    private void ToggleFornitore(string chiave)
    {
        if (!_aperte.Fornitori.Remove(chiave)) _aperte.Fornitori.Add(chiave);
    }

    private void ToggleDocumento(string chiave)
    {
        if (!_aperte.Documenti.Remove(chiave)) _aperte.Documenti.Add(chiave);
    }

    /// <summary>True se tutti i fornitori e tutti i documenti sono espansi.</summary>
    private bool TuttiAperti()
    {
        var fornitori = RaggruppaPerFornitore(Righe);
        if (fornitori.Count == 0) return false;

        foreach (var f in fornitori)
        {
            if (!_aperte.Fornitori.Contains(f.Key)) return false;

            foreach (var d in RaggruppaPerDocumento(f))
                if (!_aperte.Documenti.Contains(ChiaveDocumento(f.Key, d.Key))) return false;
        }

        return true;
    }

    private void ToggleTuttiGruppi()
    {
        if (TuttiAperti()) { _aperte.Clear(); return; }

        foreach (var f in RaggruppaPerFornitore(Righe))
        {
            _aperte.Fornitori.Add(f.Key);
            foreach (var d in RaggruppaPerDocumento(f))
                _aperte.Documenti.Add(ChiaveDocumento(f.Key, d.Key));
        }
    }
}
