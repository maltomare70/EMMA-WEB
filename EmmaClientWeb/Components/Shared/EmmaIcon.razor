@* ------------------------------------------------------------------
   Set di icone di linea inline (24x24, stroke = currentColor).
   Inline invece che come file: seguono il colore del testo e non
   aggiungono richieste HTTP. Gli attributi usano l'apice singolo
   così i tracciati restano stringhe C# senza escape.
   ------------------------------------------------------------------ *@
<svg class="emma-icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @((MarkupString)Disegno(Name))
</svg>

@code {
    /// <summary>Nome dell'icona: vedi lo switch in <see cref="Disegno"/>.</summary>
    [Parameter] public string Name { get; set; } = string.Empty;

    /// <summary>Classi CSS aggiuntive sull'elemento svg.</summary>
    [Parameter] public string? Class { get; set; }

    private static string Disegno(string name) => name switch
    {
        "home" =>
            "<rect x='3' y='3' width='7.5' height='7.5' rx='1.6'/>" +
            "<rect x='13.5' y='3' width='7.5' height='7.5' rx='1.6'/>" +
            "<rect x='3' y='13.5' width='7.5' height='7.5' rx='1.6'/>" +
            "<rect x='13.5' y='13.5' width='7.5' height='7.5' rx='1.6'/>",

        "upload" =>
            "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/>" +
            "<path d='M14 3v5h5'/><path d='M12 18v-6'/><path d='m9.5 14.5 2.5-2.5 2.5 2.5'/>",

        "doc-upload" =>
            "<path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/>" +
            "<path d='M12 15V3'/><path d='m7.5 7.5 4.5-4.5 4.5 4.5'/>",

        "search" =>
            "<circle cx='11' cy='11' r='6.4'/><path d='m20 20-4.5-4.5'/>",

        "files" =>
            "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/>" +
            "<path d='M14 3v5h5'/><path d='M8.5 13h7'/><path d='M8.5 17h5'/>",

        "truck" =>
            "<path d='M14 17.5V6.5a1.6 1.6 0 0 0-1.6-1.6H3.6A1.6 1.6 0 0 0 2 6.5v10.2c0 .5.4.8.9.8H4'/>" +
            "<path d='M14.6 17.5H9.4'/>" +
            "<path d='M14 8.6h3.2c.5 0 1 .3 1.3.7l2.2 3c.2.3.3.6.3.9v3.5c0 .5-.4.8-.9.8H20'/>" +
            "<circle cx='6.6' cy='17.7' r='2.1'/><circle cx='17.4' cy='17.7' r='2.1'/>",

        "box" =>
            "<path d='m12 3 8 4.5v9L12 21l-8-4.5v-9z'/><path d='m4 7.5 8 4.5 8-4.5'/><path d='M12 12v9'/>",

        "compare" =>
            "<path d='M4 8.5h13'/><path d='m14 5.5 3 3-3 3'/>" +
            "<path d='M20 15.5H7'/><path d='m10 12.5-3 3 3 3'/>",

        "check-doc" =>
            "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/>" +
            "<path d='M14 3v5h5'/><path d='m9 14.8 2 2 4-4'/>",

        "log" =>
            "<rect x='3' y='4' width='18' height='16' rx='2.2'/>" +
            "<path d='M7 9h10'/><path d='M7 13h10'/><path d='M7 17h6'/>",

        "key" =>
            "<circle cx='7.8' cy='15.6' r='5.2'/><path d='m11.5 11.9 8.7-8.7'/>" +
            "<path d='m15.4 8 3 3 2.9-2.9-3-3'/>",

        "book" =>
            "<path d='M12 6.5C10.6 5.2 8.7 4.5 6.5 4.5H3v13h3.5c2.2 0 4.1.7 5.5 2 1.4-1.3 3.3-2 5.5-2H21v-13h-3.5c-2.2 0-4.1.7-5.5 2z'/>" +
            "<path d='M12 6.5v13'/>",

        "logout" =>
            "<path d='M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4'/>" +
            "<path d='M10.5 12H3'/><path d='m6.5 8.5-3.5 3.5 3.5 3.5'/>",

        "menu" =>
            "<rect x='3' y='4' width='18' height='16' rx='2.2'/><path d='M9.5 4v16'/>",

        "back" =>
            "<path d='M20 12H4'/><path d='m10 6-6 6 6 6'/>",

        "arrow" =>
            "<path d='m9 5 7 7-7 7'/>",

        "user" =>
            "<circle cx='12' cy='8.5' r='3.6'/><path d='M4.8 20c1.1-3.6 3.9-5.6 7.2-5.6s6.1 2 7.2 5.6'/>",

        "lock" =>
            "<rect x='4.5' y='10' width='15' height='10.5' rx='2.2'/>" +
            "<path d='M8 10V7.5a4 4 0 0 1 8 0V10'/><path d='M12 14.2v2.6'/>",

        "eye" =>
            "<path d='M2.6 12S6.2 5.8 12 5.8 21.4 12 21.4 12 17.8 18.2 12 18.2 2.6 12 2.6 12z'/>" +
            "<circle cx='12' cy='12' r='3'/>",

        "eye-off" =>
            "<path d='m3.5 3.5 17 17'/>" +
            "<path d='M10.4 6.1A9.4 9.4 0 0 1 12 5.8c5.8 0 9.4 6.2 9.4 6.2a17.8 17.8 0 0 1-3.5 4.2'/>" +
            "<path d='M6.6 8A17.6 17.6 0 0 0 2.6 12S6.2 18.2 12 18.2a9.2 9.2 0 0 0 3.4-.65'/>" +
            "<path d='M9.9 9.9a3 3 0 0 0 4.2 4.2'/>",

        "ai" =>
            "<path d='M11 3.4 12.95 8.55 18.1 10.5 12.95 12.45 11 17.6 9.05 12.45 3.9 10.5 9.05 8.55z'/>" +
            "<path d='M18.2 14.9 19 17 21.1 17.8 19 18.6 18.2 20.7 17.4 18.6 15.3 17.8 17.4 17z'/>",

        "shield" =>
            "<path d='M12 3 4.5 6v6c0 4.4 3.1 7.8 7.5 9 4.4-1.2 7.5-4.6 7.5-9V6z'/>" +
            "<path d='m9 12 2.2 2.2L15.5 10'/>",

        _ => "<circle cx='12' cy='12' r='8'/>"
    };
}
